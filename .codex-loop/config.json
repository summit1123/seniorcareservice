{
  "version": 1,
  "agent": {
    "command": [
      "codex",
      "exec",
      "--full-auto",
      "--skip-git-repo-check",
      "--cd",
      "{project_root}",
      "--output-last-message",
      "{output_last_message}",
      "-"
    ],
    "review_command": [
      "codex",
      "exec",
      "-s",
      "read-only",
      "--skip-git-repo-check",
      "--cd",
      "{project_root}",
      "--output-last-message",
      "{output_last_message}",
      "-"
    ],
    "env": {},
    "timeout_seconds": {
      "seed": 600,
      "worker": 1800,
      "review": 600,
      "evaluator": 600,
      "replan": 600
    },
    "heartbeat_seconds": 15
  },
  "loop": {
    "completion_promise": "COMPLETE",
    "max_iterations": 0,
    "mode": "product-ui",
    "auto_seed_tasks": true,
    "require_intake_approval": false,
    "require_research_plan": false,
    "quality_profile": "product-ui",
    "workflow_profile": "idea-to-service",
    "workflow_stage": "frontend-integration",
    "workflow_goal": "안심반경 시니어 마일리지의 1년 시뮬레이션 데이터와 React 심사위원 데모를 만든다",
    "iteration_policy": "until_complete",
    "seed_retry_attempts": 2,
    "seed_local_recovery": true
  },
  "checks": {
    "commands": [
      "python3 -m unittest discover -s tests"
    ],
    "stop_on_failure": true
  },
  "review": {
    "enabled": true,
    "max_findings": 5
  },
  "context": {
    "enabled": true,
    "refresh_each_iteration": true
  },
  "evaluator": {
    "enabled": true,
    "require_pass_for_completion": true,
    "auto_extend_tasks": true
  }
}
